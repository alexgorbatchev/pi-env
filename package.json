{
  "name": "@alexgorbatchev/pi-env",
  "version": "2.0.0",
  "description": "Pi extension that injects environment variables from project config settings.",
  "type": "module",
  "author": "Alex Gorbatchev",
  "license": "MIT",
  "homepage": "https://github.com/alexgorbatchev/pi-env#readme",
  "bugs": {
    "url": "https://github.com/alexgorbatchev/pi-env/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexgorbatchev/pi-env.git"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "env",
    "configuration"
  ],
  "files": [
